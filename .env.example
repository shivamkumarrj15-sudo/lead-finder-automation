# --- APIFY CONFIGURATION ---
# Your Apify API token
APIFY_TOKEN=your_apify_api_token_here

# --- TELEGRAM CONFIGURATION ---
# Telegram Bot Token from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram Chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- LEAD GENERATION SETTINGS ---
# Search terms for Google Maps, separated by commas
SEARCH_QUERIES="cafes in Jaipur, gyms in Jaipur"

# Maximum places to search per query (needs to be at least 50 since we skip top 10 and look up to rank 50)
MAX_RESULTS_PER_SEARCH=50

# Skip the top N highly visible results (e.g. top 10)
SKIP_TOP_RESULTS=10

# Maximum leads to select and send per day
MAX_LEADS_PER_DAY=5

# Filtering criteria for active/growing businesses
MIN_REVIEWS_COUNT=10
MIN_RATING=4.0
